# Adapted from GitHub's Node, Rust and macOS templates:
# https://github.com/github/gitignore/blob/main/Node.gitignore
# https://github.com/github/gitignore/blob/main/Rust.gitignore
# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore

# Node / Vite / TypeScript dependencies and generated output
node_modules/
dist/
dist-ssr/
.vite/
.npm/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust / Tauri build output; keep package-lock.json and Cargo.lock tracked
target/
**/*.rs.bk
*.pdb
rustc-ice-*.txt
/src-tauri/gen/schemas/

# Local release bundles
/release/
*.dmg
*.app/

# Logs and process diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.pid.lock

# Test reports and coverage
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/
blob-report/

# Local environment and registry credentials; allow safe example files
.env
.env.*
!.env.example
!.env.*.example
*.local
**/.cargo/credentials
**/.cargo/credentials.toml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.eslintcache
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS metadata
.DS_Store
.localized
._*
__MACOSX/
.AppleDouble
.LSOverride
